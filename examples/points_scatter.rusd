# rusd 0.1 — 素材层：一片作者写的点，以及相机与树原型。
#
# 这份文件是 **USD**：`/World/Dots` 是一片 `Points`（UsdGeom.Points 的 point3f[]），
# 管线在 `points_scatter.ops.toml` 里——RusdScatter 用 `input_points` 读这些点
# （含世界变换），在自己的输出层写原型实例。

[stage]
default_prim = "/World"
meters_per_unit = 1.0
up_axis = "Z"

[World]
schema = "Xform"

[World.Camera]
schema = "Camera"
fov = 50.0
look_at = [4.5, 4.5, 0.0]
position = [18.0, -16.0, 12.0]

# point3f[]：外层数组的每个元素是一个 [x, y, z] 点。
[World.Dots]
schema = "Points"
points = [
    [0.0, 0.0, 0.0],
    [9.0, 0.0, 0.0],
    [0.0, 9.0, 0.0],
    [9.0, 9.0, 0.0],
    [4.5, 4.5, 3.0],
]

[World.Prototypes]
schema = "Xform"

[World.Prototypes.Pine]
schema = "Sphere"
radius = 0.6
