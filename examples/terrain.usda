#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Z"
)

# 素材层（v1.5.10）：一片 10×10 的起伏地面，4 个四边形。
#
# 这一层**不属于**任何 .rusd 的 root 层栈——它不是 sublayer。它是被
# `[World.Terrain] references = "terrain.usda:/World/Terrain"` 的 **prim 级 reference
# 弧**打开的：地形是素材，作者层只留一条引用弧 + 自己的位置，几何全部从这里合成。
# 与 prototypes.usda（实例原型库）同一个机制，区别只在用途：
# 原型被一次引用很多份（每份一个实例），地形被引用一次，当作场景里的一块地。
#
# root 层的 /World/Terrain 因此没有自己的 typeName（引用会赢过局部类型），
# 类型 `Mesh`、points / faceVertexCounts / faceVertexIndices 都由这一层给出。
def Xform "World"
{
    def Mesh "Terrain"
    {
        int[] faceVertexCounts = [4, 4, 4, 4]
        int[] faceVertexIndices = [0, 1, 4, 3, 1, 2, 5, 4, 3, 4, 7, 6, 4, 5, 8, 7]
        point3f[] points = [
            (0.0, 0.0, 0.0),
            (5.0, 0.0, 0.5),
            (10.0, 0.0, 0.0),
            (0.0, 5.0, 0.5),
            (5.0, 5.0, 1.5),
            (10.0, 5.0, 0.4),
            (0.0, 10.0, 0.0),
            (5.0, 10.0, 0.3),
            (10.0, 10.0, 0.0),
        ]
    }
}