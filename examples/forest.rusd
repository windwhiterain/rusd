# rusd 0.1 — 素材层：一片松林的相机与树原型。
#
# 这份文件是 **USD**：只有 prim 和 schema，没有算子。RusdScatter 在
# `forest.ops.toml` 里引用它（`/World/Prototypes/Pine` 就是那棵被实例化的树）。

[stage]
default_prim = "/World"
meters_per_unit = 1.0
up_axis = "Z"

[World]
schema = "Xform"

[World.Camera]
schema = "Camera"
fov = 45.0
look_at = [0.0, 0.0, 0.0]
position = [60.0, -60.0, 40.0]

[World.Prototypes]
schema = "Xform"

[World.Prototypes.Pine]
schema = "Sphere"
radius = 0.5
