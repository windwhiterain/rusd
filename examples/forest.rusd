# rusd 0.1 — 示例：一片确定性松林（M1 后可解析；语法见 docs/SPEC.md §2）
# 规范形式：扁平块，绝对路径寻址，块按路径字节序排序。

stage {
    up_axis = "Z"
    meters_per_unit = 1.0
    default_prim = "/World"
    seed = 20261116
}

def Camera /World/Camera {
    fov = 45.0
    look_at = [0.0, 0.0, 0.0]
    position = [60.0, -60.0, 40.0]
}

def RusdScatter /World/Forest {
    count = 500
    domain = rect(100.0, 100.0)
    max_prims = 2000
    prototype = /World/Prototypes/Pine
    scale = uniform(0.8, 1.4)
    seed = 42
    yaw = uniform(0.0, 360.0)
}

def Xform /World/Prototypes

def Sphere /World/Prototypes/Pine {
    radius = 0.5
}

def Xform /World {
}