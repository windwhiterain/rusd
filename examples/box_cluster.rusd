# rusd 0.1 — 第一阶段（独立 stage）：Cube 体积 → 盒内采样 → 实例化 box
#
# 这一份只做第一段；产物用 `rusd export --no-bake` 导成 cluster.usda，
# 供第二阶段的 box_scatter.rusd 以**跨资产 reference** 引用：
#
#   rusd export examples/box_cluster.rusd examples/cluster.usda --no-bake
#
# 两个 stage 因此通过资产边界组合：第二阶段只认识 cluster.usda:/World/Boxes。

[stage]
default_prim = "/World"
meters_per_unit = 1.0
seed = 20261118
up_axis = "Z"

[World]
schema = "Xform"

[World.Camera]
fov = 50.0
look_at = [0.0, 0.0, 0.0]
position = [14.0, -18.0, 12.0]
schema = "Camera"

[World.Volume]
references = "volume.usda:/World/Volume"

[World.Samples]
count = 60
description = "在 Volume 盒内均匀采 60 个点（第一阶段）"
input_points = "/World/Volume"
schema = "RusdSamplePoints"
seed = 11

[World.Boxes]
description = "每个点放一个 box，得到一簇 box（原型来自素材层）"
input_points = "/World/Samples/points"
max_prims = 5000
prototype = "prototypes.usda:/World/Prototypes/Box"
schema = "RusdInstances"
seed = 11

[doc.material]
description = "可实例化的 box 素材（由 reference 弧打开）"
layer = "prototypes.usda"

[doc.volume]
description = "第一阶段的采样域：一个 Cube 素材（由 prim 级 reference 弧打开）"
layer = "volume.usda"

[doc.root]
description = "box_cluster.rusd：第一阶段的作者层"
layer = "root"
