#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Z"
)

# 素材层：第一阶段的采样域。
#
# 它**不属于** .rusd 的 root 层栈——不是 sublayer。它是被 box_scatter.rusd 的
# `[World.Volume] references = "volume.usda:/World/Volume"` 的 **prim 级 reference
# 弧**打开的：采样域是素材，作者层只留一条引用弧，`size` 全部从这里合成。
# 与 terrain.usda / prototypes.usda 同一个机制，区别只在用途。
def Xform "World"
{
    def Cube "Volume"
    {
        double size = 6
    }
}
