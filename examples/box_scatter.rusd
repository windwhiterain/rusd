# rusd 0.1 — v1.5.10 演示：**两段实例化叠加**
#
#   第一阶段：Cube 体积 → 盒内采样 → 每点实例化一个 box（一簇 60 个 box）
#   第二阶段：Mesh 表面 → 面积加权采样 → 每点实例化**第一阶段得到的那一簇 box**
#              （同栈 reference 指向 /World/Boxes——实例的实例）
#
# 结果：quad 表面上摆了 40 簇、每簇 60 个 box（外加原点的原型簇）。
# box 原型本身仍在素材层 prototypes.usda（由跨资产 reference 打开，独立成层）。
#
#   upto = null（root）         → 只见 Volume 盒 + Terrain
#   upto = /World/Samples       → 只见体积点云
#   upto = /World/Boxes         → 只见一簇 box
#   upto = /World/SurfaceSamples→ 只见表面点云
#   upto = /World/Clusters      → 只见含簇前的状态/最终同
#
# 替换语义逐 op 成立：sample 盖住 Volume、instances 盖住体积点云、
# 表面 sample 盖住 Terrain、最后一段 instances 盖住表面点云。

[stage]
default_prim = "/World"
meters_per_unit = 1.0
seed = 20261118
up_axis = "Z"

[World]
schema = "Xform"

[World.Camera]
fov = 50.0
look_at = [5.0, 5.0, 0.0]
position = [22.0, -18.0, 16.0]
schema = "Camera"

# --- 第一阶段的输入与产出 ----------------------------------------------------
[World.Volume]
schema = "Cube"
size = 6.0

[World.Samples]
count = 60
description = "在 Volume 盒内均匀采 60 个点（第一阶段）"
input_points = "/World/Volume"
schema = "RusdSamplePoints"
seed = 11

[World.Boxes]
description = "每个点放一个 box，得到一簇 box（原型来自素材层）"
input_points = "/World/Samples/points"
max_prims = 5000
prototype = "prototypes.usda:/World/Prototypes/Box"
schema = "RusdInstances"
seed = 11

# --- 第二阶段的输入与产出 ----------------------------------------------------
# 一块 10×10 的起伏地面（4 个四边形），与 mesh_scatter.rusd 同款。
[World.Terrain]
faceVertexCounts = [4, 4, 4, 4]
faceVertexIndices = [0, 1, 4, 3, 1, 2, 5, 4, 3, 4, 7, 6, 4, 5, 8, 7]
points = [
    [0.0, 0.0, 0.0],
    [5.0, 0.0, 0.5],
    [10.0, 0.0, 0.0],
    [0.0, 5.0, 0.5],
    [5.0, 5.0, 1.5],
    [10.0, 5.0, 0.4],
    [0.0, 10.0, 0.0],
    [5.0, 10.0, 0.3],
    [10.0, 10.0, 0.0],
]
schema = "Mesh"

[World.SurfaceSamples]
count = 40
description = "在 Terrain 表面面积加权采 40 个点（第二阶段）"
input_points = "/World/Terrain"
schema = "RusdSamplePoints"
seed = 7

# prototype 是**同栈**路径：指向第一阶段产出的那簇 box（/World/Boxes）。
# 每个表面样本实例化整簇——实例里套实例。
[World.Clusters]
description = "把第一阶段的一簇 box 实例化到 quad 表面"
input_points = "/World/SurfaceSamples/points"
max_prims = 5000
prototype = "/World/Boxes"
schema = "RusdInstances"
seed = 7

# --- 层的说明（注记节点：无 schema + layer 键）--------------------------------
[doc.material]
description = "可实例化的 box 素材（由 reference 弧打开，不在本文件的层栈里）"
layer = "prototypes.usda"

[doc.root]
description = "box_scatter.rusd：两段实例化的作者层"
layer = "root"
