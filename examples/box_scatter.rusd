# rusd 0.1 — v1.9：**一个合成图**里的两段实例化
#
#   第一段：volume 采样 → box      /World.Volume(Cube 素材) → Samples(点) → Boxes(一簇 box)
#   第二段：mesh 采样 → 簇          /World.Terrain(Mesh 素材) → SurfaceSamples(点) → Clusters(40 簇)
#
# 四个 op 层 + 三个素材层，全部在**同一棵合成图**里可见：
#   RusdSamplePoints /World/Samples        （第一段的采样）
#   RusdInstances    /World/Boxes          （第一段：box 实例，原型来自 prototypes.usda）
#   RusdSamplePoints /World/SurfaceSamples （第二段的采样）
#   RusdInstances    /World/Clusters       （第二段：簇实例，原型是同栈 /World/Boxes）
# 素材层（各自独立的 reference 层）：volume.usda / terrain.usda / prototypes.usda。

[stage]
default_prim = "/World"
meters_per_unit = 1.0
seed = 20261118
up_axis = "Z"

[World]
schema = "Xform"

[World.Camera]
fov = 50.0
look_at = [5.0, 5.0, 0.0]
position = [22.0, -18.0, 16.0]
schema = "Camera"

# --- 第一段：volume 采样 → box -----------------------------------------------
[World.Volume]
references = "volume.usda:/World/Volume"

[World.Samples]
count = 60
description = "在 Volume 盒内均匀采 60 个点（第一阶段）"
input_points = "/World/Volume"
schema = "RusdSamplePoints"
seed = 11

[World.Boxes]
description = "每个点放一个 box，得到一簇 box（原型来自素材层）"
input_points = "/World/Samples/points"
max_prims = 5000
prototype = "prototypes.usda:/World/Prototypes/Box"
schema = "RusdInstances"
seed = 11

# --- 第二段：mesh（quad）采样 → 簇 -------------------------------------------
[World.Terrain]
references = "terrain.usda:/World/Terrain"

[World.SurfaceSamples]
count = 40
description = "在 Terrain 表面面积加权采 40 个点（第二阶段）"
input_points = "/World/Terrain"
schema = "RusdSamplePoints"
seed = 7

[World.Clusters]
description = "把第一阶段的一簇 box 实例化到 quad 表面"
input_points = "/World/SurfaceSamples/points"
max_prims = 5000
prototype = "/World/Boxes"
schema = "RusdInstances"
seed = 7

# --- 三个素材层的说明（注记节点：无 schema + layer 键）-----------------------
[doc.prototypes]
description = "box 原型库（被第一段的实例跨资产引用）"
layer = "prototypes.usda"

[doc.terrain]
description = "10×10 起伏地面素材（由 prim 级 reference 弧打开）"
layer = "terrain.usda"

[doc.volume]
description = "第一阶段的采样域：一个 Cube 素材（由 prim 级 reference 弧打开）"
layer = "volume.usda"

[doc.root]
description = "box_scatter.rusd：两段实例化的作者层（volume→box，quad→簇）"
layer = "root"
