# rusd 0.1 — 第二阶段（独立 stage）：把 assets 当外部资产，在 quad 表面实例化一簇 box
#
# 这一份**只认识资产**，不认识第一阶段的内部层：
#
#   /World/Terrain   —— prim 级 reference 打开 terrain.usda（10×10 起伏地面素材）
#   /World/SurfaceSamples —— RusdSamplePoints：表面面积加权采 40 个点
#   /World/Clusters  —— RusdInstances：每个表面样本实例化**一簇 box**，
#                       原型 = cluster.usda:/World/Boxes（第一阶段的产物导出成资产）；
#                       cluster.usda 内部再引用 prototypes.usda 的 box 原型——资产套资产。
#
# 第一阶段见 box_cluster.rusd，产物用 `comp_node` 的层原文导出（见 cluster.usda 文件头）。

[stage]
default_prim = "/World"
meters_per_unit = 1.0
seed = 20261118
up_axis = "Z"

[World]
schema = "Xform"

[World.Camera]
fov = 50.0
look_at = [5.0, 5.0, 0.0]
position = [22.0, -18.0, 16.0]
schema = "Camera"

# --- 实例化目标面：地形素材（prim 级 reference）-------------------------------
[World.Terrain]
references = "terrain.usda:/World/Terrain"

# --- 表面采样 → 实例化一簇 box（原型是第一阶段导出的资产）---------------------
[World.SurfaceSamples]
count = 40
description = "在 Terrain 表面面积加权采 40 个点（第二阶段）"
input_points = "/World/Terrain"
schema = "RusdSamplePoints"
seed = 7

[World.Clusters]
description = "把第一阶段的一簇 box（cluster.usda 资产）实例化到 quad 表面"
input_points = "/World/SurfaceSamples/points"
max_prims = 5000
prototype = "cluster.usda:/World/Boxes"
schema = "RusdInstances"
seed = 7

# --- 层的说明（注记节点：无 schema + layer 键）--------------------------------
[doc.terrain]
description = "10×10 起伏地面素材（由 prim 级 reference 弧打开）"
layer = "terrain.usda"

[doc.cluster]
description = "第一阶段的产物：一簇 box（由 cluster.usda 资产提供）"
layer = "cluster.usda"

[doc.prototypes]
description = "box 原型库（被 cluster.usda 内部引用，跨两层资产）"
layer = "prototypes.usda"

[doc.root]
description = "box_scatter.rusd：第二阶段（quad 表面实例化）的作者层"
layer = "root"
