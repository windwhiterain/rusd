#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Z"
)

# 素材层（v1.5.8）：可被实例化的原型库。
#
# 这一层**不属于**任何 .rusd 的 root 层栈——它不是 sublayer。它是被
# `prototype = "prototypes.usda:/World/Prototypes/<名>"` 的 **reference 弧**打开的：
# 素材被实例化就该是 reference（跨资产边界引用），而不是 sublayer（同栈作者拆分）。
#
# 两个原型，各喂一个示例：
#   Box  —— box_scatter.rusd：在 box 体积里采样，每个点放一个 0.6 的 box
#   Tuft —— mesh_scatter.rusd：在地面上采样，每个点放一丛 0.35 的球
#
# 实例只带自己的 translate/scale，类型与几何全部从这里合成。
def Xform "World"
{
    def Xform "Prototypes"
    {
        def Cube "Box"
        {
            double size = 0.6
        }

        def Sphere "Tuft"
        {
            double radius = 0.35
        }
    }
}