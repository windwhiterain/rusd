# rusd 0.1 — 城市 generator 演示（M3）
# RusdStreetGrid 生成街区 + 建筑（高度按分区分布采样）；
# RusdScatter 撒布行道树（读 Tree 原型 radius，形成 cook 依赖）。

[stage]
default_prim = "/World"
meters_per_unit = 1.0
seed = 20261116
up_axis = "Z"

[World]
schema = "Xform"

[World.Camera]
fov = 50.0
look_at = [180.0, 180.0, 0.0]
position = [420.0, -260.0, 220.0]
schema = "Camera"

[World.City]
block_size = [60.0, 60.0]
blocks_x = 6
blocks_y = 6
floor_height = 3.2
height = { dist = "normal", mu = 24.0, sigma = 10.0 }
lot_width = 18.0
margin = 4.0
max_prims = 20000
occupancy = 0.9
schema = "RusdStreetGrid"
seed = 7
street_width = 12.0
zone = "commercial"

[World.Prototypes]
schema = "Xform"

[World.Prototypes.Tree]
radius = 2.0
schema = "Sphere"

[World.StreetProps]
count = 300
domain = { dist = "rect", w = 420.0, h = 420.0 }
max_prims = 300
prototype = "/World/Prototypes/Tree"
scale = { dist = "uniform", min = 0.8, max = 1.3 }
schema = "RusdScatter"
seed = 23