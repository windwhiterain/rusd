# rusd 0.1 — 素材层：城市演示的相机与行道树原型。
#
# 这份文件是 **USD**：只有 prim 和 schema。两个算子（街区、行道树）在
# `city.ops.toml` 里跑，行道树实例化的是这里的 `/World/Prototypes/Tree`。

[stage]
default_prim = "/World"
meters_per_unit = 1.0
up_axis = "Z"

[World]
schema = "Xform"

[World.Camera]
schema = "Camera"
fov = 50.0
look_at = [180.0, 180.0, 0.0]
position = [420.0, -260.0, 220.0]

[World.Prototypes]
schema = "Xform"

[World.Prototypes.Tree]
schema = "Sphere"
radius = 2.0
