# rusd 0.1 — v1.5 演示：mesh → points → instances 两段 op 管线
# 输入层持有一块 3×3 顶点（4 个四边形）的起伏地面（UsdGeom.Mesh：points +
# faceVertexCounts + faceVertexIndices）。管线拆成两个显式 op，中间态是一个真 layer：
#
#   /World/Terrain       —— 作者的 mesh（输入；不属于任何 op）
#   /World/TuftSamples   —— RusdSamplePoints：按三角形**面积加权**采样 240 个点
#                           （累积面积选三角形 + 重心坐标选点），在**自己的输出层**
#                           写 /World/TuftSamples/points（point3f[]）
#   /World/Tufts         —— RusdInstances：读那个点云，逐点写原型实例
#                           /World/Tufts/i000000…，在**自己的输出层**
#
# 替换语义**逐 op 成立**（PROTOCOL v1.5.1）：每段 op 在自己的输出层对**它消费掉的
# 那个 prim** 写 `visibility = "invisible"` 的 over —— sample 盖住 mesh，instances
# 盖住点云。输入 spec 一处不删，所以三档前缀**互斥可见**：
#
#   upto = null（root）      → 只见 mesh
#   upto = /World/TuftSamples → 只见点云
#   upto = /World/Tufts      → 只见实例
#
# 确定性：采样流按 (stage.seed, 节点路径, 该节点 seed) 键控，改别的节点不 reshuffle。

[stage]
default_prim = "/World"
meters_per_unit = 1.0
seed = 20261118
up_axis = "Z"

[World]
schema = "Xform"

[World.Camera]
fov = 50.0
look_at = [5.0, 5.0, 0.5]
position = [19.0, -15.0, 12.0]
schema = "Camera"

# --- 输入：3×3 个顶点组成的起伏地面（4 个四边形） --------------------------
# 顶点索引 = 行 * 3 + 列。
[World.Terrain]
faceVertexCounts = [4, 4, 4, 4]
faceVertexIndices = [0, 1, 4, 3, 1, 2, 5, 4, 3, 4, 7, 6, 4, 5, 8, 7]
points = [
    [0.0, 0.0, 0.0],
    [5.0, 0.0, 0.5],
    [10.0, 0.0, 0.0],
    [0.0, 5.0, 0.5],
    [5.0, 5.0, 1.5],
    [10.0, 5.0, 0.4],
    [0.0, 10.0, 0.0],
    [5.0, 10.0, 0.3],
    [10.0, 10.0, 0.0],
]
schema = "Mesh"

# --- 第一段：mesh 表面 → 点云 ---------------------------------------------
# 只吃 mesh 表面（无 mesh 拓扑 ⇒ E_INPUT_GEOMETRY，不会退化成"每个顶点一个点"）。
# 输出 /World/TuftSamples/points；同一层对 /World/Terrain 写 visibility=invisible。
[World.TuftSamples]
count = 240
input_points = "/World/Terrain"
schema = "RusdSamplePoints"
seed = 11

# --- 第二段：点云 → 原型实例 ---------------------------------------------
# 只吃点云（没有 points ⇒ E_INPUT_GEOMETRY）。没有 count 参数：点云里有几个点就
# 几个实例，max_prims 只做预算截断（保原序 + W_BUDGET）。
# 输出 /World/Tufts/i000000…；同一层对 /World/TuftSamples/points 写 visibility=invisible。
# 原型在**另一个层**里（v1.5.8）：素材被实例化就该是 reference，而不是 sublayer。
# `asset:prim` 形式的 prototype 让每个实例的 reference 跨资产边界指向
# examples/prototypes.usda 的 /World/Prototypes/Tuft；那一层由 reference 弧打开，
# 不在本文件的 root 层栈里，所以在 composition_tree 里是独立的层（op = false）。
# 相对资产路径按**本文档所在目录**解析（open{content} 无目录 ⇒ E_PROTOTYPE_ASSET）。
[World.Tufts]
input_points = "/World/TuftSamples/points"
max_prims = 5000
prototype = "tuft.rusd:/World/Prototypes/Tuft"
scale = { dist = "uniform", min = 0.7, max = 1.5 }
schema = "RusdInstances"
seed = 11
