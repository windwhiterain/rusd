# rusd 0.1 — 素材层：起伏地面的 mesh，以及相机。
#
# 这份文件是 **USD**：一块 3×3 顶点（4 个四边形）的起伏地面（UsdGeom.Mesh：points +
# faceVertexCounts + faceVertexIndices），管线在 `mesh_scatter.ops.toml` 里：
#
#   RusdSamplePoints  按三角形**面积加权**采样 240 个点（累积面积选三角形 + 重心坐标
#                     选点），在自己的输出层写 /World/TuftSamples/points（point3f[]）
#   RusdInstances     读那个点云，逐点写原型实例 /World/Tufts/i000000…，原型来自
#                     `tuft.rusd:/World/Prototypes/Tuft`

[stage]
default_prim = "/World"
meters_per_unit = 1.0
up_axis = "Z"

[World]
schema = "Xform"

[World.Camera]
schema = "Camera"
fov = 50.0
look_at = [5.0, 5.0, 0.5]
position = [19.0, -15.0, 12.0]

[World.Terrain]
schema = "Mesh"
faceVertexCounts = [4, 4, 4, 4]
faceVertexIndices = [0, 1, 4, 3, 1, 2, 5, 4, 3, 4, 7, 6, 4, 5, 8, 7]
points = [
    [0.0, 0.0, 0.0],
    [5.0, 0.0, 0.5],
    [10.0, 0.0, 0.0],
    [0.0, 5.0, 0.5],
    [5.0, 5.0, 1.5],
    [10.0, 5.0, 0.4],
    [0.0, 10.0, 0.0],
    [5.0, 10.0, 0.3],
    [10.0, 10.0, 0.0],
]
